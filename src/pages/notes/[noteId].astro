---
import Layout from "@/layouts/Layout.astro";
import { QuizGenerationController } from "@/components/QuizGenerationController";
import { findNoteById } from "@/lib/services/notes.service";
import { renderMarkdown } from "@/lib/markdown/renderMarkdown";

const { noteId } = Astro.params;
const { user, supabase } = Astro.locals;

if (!user) {
  return Astro.redirect("/");
}

if (!noteId) {
  return new Response("Note ID is required", { status: 400 });
}

const note = await findNoteById(supabase, noteId, user.id);

if (!note) {
  return new Response("Note not found", { status: 404 });
}

const { html: noteHtml, toc } = await renderMarkdown(note.content);

// TODO: Replace with actual user data when implemented
const userData = {
  hasUserApiKey: false,
  freeQuizzesRemaining: 5,
};

// Check if there's an accepted quiz for this note
const { data: acceptedQuiz } = await supabase
  .from("quizzes")
  .select("id")
  .eq("note_id", noteId)
  .eq("status", "accepted")
  .order("created_at", { ascending: false })
  .limit(1)
  .single();
---

<Layout title={`Note: ${note.title}`}>
  <main class="container mx-auto py-12">
    <div class="max-w-7xl mx-auto px-4">
      <a href="/notes" class="text-sm text-primary hover:underline mb-4 inline-block">&larr; Back to Notes</a>
      <h1 class="text-4xl font-bold mb-6">{note.title}</h1>

      <div class="flex gap-8 items-start">
        {
          toc.length > 0 ? (
            <aside class="w-64 flex-shrink-0 sticky top-4 max-h-[calc(100vh-2rem)] overflow-y-auto">
              <div class="rounded-md border bg-card p-4 text-sm">
                <div class="font-semibold mb-2">Table of contents</div>
                <nav aria-label="Table of contents">
                  <ol class="space-y-1">
                    {toc.map((item) => (
                      <li style={`padding-left: ${(item.level - 1) * 16}px`}>
                        <a
                          class="hover:underline text-muted-foreground hover:text-foreground transition-colors"
                          href={`#${item.id}`}
                        >
                          {item.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                </nav>
              </div>
            </aside>
          ) : null
        }

        <div class="flex-1 min-w-0 max-w-4xl">
          <div class="mb-8 pb-6 border-b" id="actions-section">
            <h2 class="text-2xl font-bold mb-4">Actions</h2>
            <div class="flex gap-4">
              <QuizGenerationController
                client:idle
                noteId={note.id}
                hasUserApiKey={userData.hasUserApiKey}
                freeQuizzesRemaining={userData.freeQuizzesRemaining}
              />
              {
                acceptedQuiz && (
                  <a
                    href={`/quizzes/${acceptedQuiz.id}/solve`}
                    class="inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow hover:bg-primary/90 h-9 px-4 py-2"
                  >
                    Solve Quiz
                  </a>
                )
              }
            </div>
          </div>

          <div class="prose dark:prose-invert max-w-none" id="note-content">
            {
              noteHtml ? (
                <Fragment set:html={noteHtml} />
              ) : (
                <p class="text-muted-foreground italic">This note is empty.</p>
              )
            }
          </div>
        </div>
      </div>
    </div>

    <style>
      /* Minimal highlight.js theme tweaks for dark/light */
      :global(pre.hljs) {
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        background: color-mix(in oklab, canvas 92%, black 8%);
      }
      :global(code.hljs) {
        background: transparent;
      }

      .scroll-to-top {
        position: fixed;
        bottom: 2rem;
        right: 2rem;
        opacity: 0;
        visibility: hidden;
        transition:
          opacity 0.3s,
          visibility 0.3s;
      }

      .scroll-to-top.visible {
        opacity: 1;
        visibility: visible;
      }
    </style>

    <button
      id="scroll-to-top"
      class="scroll-to-top inline-flex items-center justify-center whitespace-nowrap rounded-full text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:pointer-events-none disabled:opacity-50 bg-primary text-primary-foreground shadow-lg hover:bg-primary/90 h-12 w-12"
      aria-label="Scroll to top"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m18 15-6-6-6 6"></path>
      </svg>
    </button>

    <script src="@/scripts/notePageInteractions.ts"></script>
  </main>
</Layout>
