---
import "../styles/global.css";
import { Toaster } from "@/components/ui/sonner";
import { AuthThemeWrapper } from "@/components/AuthThemeWrapper";
import { themeInitScript } from "@/scripts/themeInit";

interface Props {
  title?: string;
}

const { title = "10x Astro Starter" } = Astro.props;
---

<!doctype html>
<html lang="en" suppressHydrationWarning>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline set:html={themeInitScript} />
  </head>
  <body class="flex min-h-screen flex-col">
    <AuthThemeWrapper client:load>
      <main class="flex justify-center py-12 px-4">
        <slot />
      </main>
      <Toaster richColors client:load />
    </AuthThemeWrapper>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
  }
</style>
